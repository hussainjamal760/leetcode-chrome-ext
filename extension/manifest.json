{
  "manifest_version": 3,
  "name": "LeetCode Auto Sync",
  "version": "1.0.0",
  "description": "Automatically sync LeetCode solutions to GitHub and Notion with AI summaries",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*/submissions/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
